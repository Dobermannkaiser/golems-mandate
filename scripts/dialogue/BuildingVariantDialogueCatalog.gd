static func create(dialogue_id: String) -> Dictionary:
	var data_value: Variant = DIALOGUES.get(dialogue_id, {})
	if not data_value is Dictionary:
		return {}
	var data: Dictionary = data_value as Dictionary
	if data.is_empty():
		return {}
	return {
		"id": dialogue_id,
		"title": String(data.get("title", "Uma nova construção")),
		"start": "scene",
		"allow_close": false,
		"nodes": {
			"scene": {
				"speaker_id": "",
				"speaker_name": "Narrador",
				"hide_portrait": true,
				"text": String(data.get("scene", "A vila observa a nova construção.")),
				"next": "reaction"
			},
			"reaction": {
				"speaker_id": String(data.get("speaker_id", "mimo")),
				"speaker_name": String(data.get("speaker_name", "Mimo")),
				"expression": "happy",
				"text": String(data.get("line", "A vila parece diferente agora."))
			}
		}
	}


static func get_dialogue_ids() -> Array[String]:
	var result: Array[String] = []
	for key_value: Variant in DIALOGUES.keys():
		result.append(String(key_value))
	result.sort()
	return result
